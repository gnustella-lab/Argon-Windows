#include <winres.h>

#ifdef HAVE_VERSION_DEFS
#include "version_defs.h"
#endif

#ifndef ARGON_ICON_PATH
#define ARGON_ICON_PATH "argon.ico"
#endif

#ifndef ARGON_VERSION_STR
#define ARGON_VERSION_STR "0.1.3"
#endif

#ifndef ARGON_FILEVERSION_CSV
#define ARGON_FILEVERSION_CSV 0,1,3,0
#endif

1 RT_MANIFEST "argon-portable.manifest"
101 ICON ARGON_ICON_PATH

VS_VERSION_INFO VERSIONINFO
 FILEVERSION ARGON_FILEVERSION_CSV
 PRODUCTVERSION ARGON_FILEVERSION_CSV
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Argon"
            VALUE "FileDescription", "Argon Browser (Portable Launcher)"
            VALUE "FileVersion", ARGON_VERSION_STR
            VALUE "InternalName", "argon-portable"
            VALUE "OriginalFilename", "argon-portable.exe"
            VALUE "ProductName", "Argon Browser"
            VALUE "ProductVersion", ARGON_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
