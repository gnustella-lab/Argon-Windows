{
  "name": "argon-browser",
  "version": "0.1.3",
  "private": true,
  "description": "Argon Browser: an independent desktop browser forked from Firefox (Gecko), with an Arc-inspired interface and a Chromium extension compatibility bridge.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/run-python.mjs scripts/dev-browser.py",
    "dev:sync": "node scripts/run-python.mjs scripts/dev-browser.py --sync-only",
    "dev:reset": "node scripts/run-python.mjs scripts/dev-browser.py --reset-profile",
    "reset": "node scripts/run-python.mjs scripts/dev-browser.py --reset-profile --sync-only",
    "run:reset": "node scripts/run-python.mjs scripts/dev-browser.py --reset-profile",
    "test:dev": "node scripts/run-python.mjs -m unittest discover -s tests/dev -q",
    "test": "node scripts/run-unit-tests.mjs",
    "build:adblock": "node scripts/run-python.mjs scripts/build-native-adblock.py",
    "test:adblock": "node --test tests/adblock/*.test.mjs && node scripts/run-python.mjs tests/adblock/test_native.py",
    "update:adblock": "node scripts/run-python.mjs scripts/update-native-adblock-lists.py",
    "test:appearance": "node --test tests/appearance/*.test.mjs",
    "test:onboarding": "node --test tests/onboarding/*.test.mjs",
    "test:extensions": "node --test tests/extensions/*.test.mjs",
    "test:website": "node --test tests/website/*.test.mjs",
    "test:build": "node scripts/run-python.mjs -m unittest discover -s tests/build -q",
    "test:branding": "node scripts/run-python.mjs -m unittest discover -s tests/branding -q",
    "test:python": "npm run test:build && npm run test:branding",
    "analyze": "node argon/extensions/analyze-cli.mjs",
    "site": "node scripts/serve-website.mjs",
    "doctor": "node scripts/run-python.mjs scripts/argon.py doctor",
    "fetch": "node scripts/run-python.mjs scripts/argon.py fetch",
    "apply": "node scripts/run-python.mjs scripts/argon.py apply",
    "bootstrap": "node scripts/run-python.mjs scripts/argon.py bootstrap",
    "build": "node scripts/run-python.mjs scripts/argon.py build",
    "build:artifact": "node scripts/run-python.mjs scripts/argon.py --artifact build",
    "start": "node scripts/run-python.mjs scripts/argon.py run",
    "package": "node scripts/run-python.mjs scripts/argon.py package",
    "stage:runtime": "node scripts/run-python.mjs scripts/argon.py stage-runtime",
    "win:portable": "node scripts/run-python.mjs scripts/argon.py win-portable",
    "win:installer": "node scripts/run-python.mjs scripts/argon.py win-installer",
    "verify:windows": "node scripts/run-python.mjs scripts/argon.py verify-windows",
    "test:ghostprint": "node --test tests/adblock/ghostprint.test.mjs third_party/ghostprint/tests/*.test.js",
    "test:browser:ghostprint": "node scripts/run-browser-tests.mjs --ghostprint",
    "test:browser:adblock": "node scripts/run-browser-tests.mjs --adblock",
    "test:browser:limits": "node scripts/run-browser-tests.mjs --limits",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "diagnose:browser": "node scripts/run-browser-tests.mjs --diagnose",
    "test:browser:workspaces": "node scripts/run-browser-tests.mjs --workspaces"
  },
  "keywords": [
    "browser",
    "firefox",
    "gecko",
    "webextensions",
    "argon"
  ]
}
